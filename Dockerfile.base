FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-jpn \
    tesseract-ocr-por \
    tesseract-ocr-spa \
    tesseract-ocr-fra \
    tesseract-ocr-deu \
    tesseract-ocr-ita \
    tesseract-ocr-kor \
    tesseract-ocr-chi-sim \
    poppler-utils \
    fonts-noto-cjk \
    fonts-dejavu-core \
    libgomp1 \
    libglib2.0-0 \
    libgl1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --timeout=300 -r requirements.txt

# Extract CJK subfonts from the NotoSansCJK TTC and convert CFF→TrueType.
# fpdf2's CFF subsetting corrupts complex CJK glyph outlines (leaving them
# invisible), while its TrueType subsetting works correctly.  Converting to
# actual TrueType outlines (cu2qu) fixes the invisible-glyph problem.
RUN python3 - <<'EOF'
import os, sys, subprocess
try:
    from fontTools.ttLib import TTCollection
    src = "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
    out_dir = "/usr/local/share/fonts/noto-cjk"
    os.makedirs(out_dir, exist_ok=True)
    if not os.path.exists(src):
        print(f"WARNING: {src} not found", file=sys.stderr)
        sys.exit(0)
    coll = TTCollection(src)
    for i, name in enumerate(["NotoSansCJKjp", "NotoSansCJKkr", "NotoSansCJKsc", "NotoSansCJKtc"]):
        if i >= len(coll):
            break
        otf_path = f"{out_dir}/{name}-Regular.otf"
        ttf_path = f"{out_dir}/{name}-Regular.ttf"
        coll[i].save(otf_path)
        # Convert CFF outlines → TrueType outlines so fpdf2 embeds correctly
        result = subprocess.run(
            ["python3", "-m", "fonttools", "otf2ttf", otf_path, "-o", ttf_path],
            capture_output=True, text=True, timeout=300,
        )
        if result.returncode == 0 and os.path.exists(ttf_path):
            os.unlink(otf_path)
            print(f"Extracted+converted to TTF: {ttf_path}")
        else:
            print(f"WARNING: otf2ttf failed for {name}, keeping OTF: {result.stderr.strip()}", file=sys.stderr)
except Exception as e:
    print(f"Font extraction failed: {e}", file=sys.stderr)
EOF
